# ==========================================
# KONFIGURASI BOT TELEGRAM SERVER
# ==========================================

# Dapatkan Token Bot dari @BotFather di Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram User ID Anda (Dapatkan dari @userinfobot)
# User ID ini otomatis memiliki akses Super Admin
OWNER_ID=123456789

# Port (opsional jika menggunakan webhook di masa depan)
PORT=3000
